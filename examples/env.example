# .env olarak kopyalayın (git tarafından yok sayılır) ve Linux/macOS'ta
# `source .env` ile yükleyin. Windows için en alttaki PowerShell bloğunu kullanın.

# Temel URL: betikler eksikse /v1/chat/completions, /v1/models ya da
# /v1/embeddings sonekini kendisi ekler
export LLM_ENDPOINT="http://10.0.0.10:8000"

# Bearer token. -k yerine bunu tercih edin: parametre `ps aux` çıktısında ve
# shell geçmişinde görünür.
export LLM_API_KEY="sk-degistirin"

# Chat modeli, sunucunun adlandırdığı şekilde (bkz: bash/llm-models.sh)
export LLM_MODEL="Qwen/Qwen2.5-7B-Instruct"

# Embedding modeli, LLM_MODEL'den farklıysa
export LLM_EMBED_MODEL="BAAI/bge-m3"

# Reranker modeli (rerank-test.py ve llm-check.sh --full için)
export LLM_RERANK_MODEL="BAAI/bge-reranker-v2-m3"

# ---------------------------------------------------------------------------
# PowerShell karşılığı:
#
#   $env:LLM_ENDPOINT    = 'http://10.0.0.10:8000'
#   $env:LLM_API_KEY     = 'sk-degistirin'
#   $env:LLM_MODEL       = 'Qwen/Qwen2.5-7B-Instruct'
#   $env:LLM_EMBED_MODEL  = 'BAAI/bge-m3'
#   $env:LLM_RERANK_MODEL = 'BAAI/bge-reranker-v2-m3'
