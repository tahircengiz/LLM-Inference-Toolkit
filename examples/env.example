# Copy to .env (git-ignored) and `source .env` on Linux/macOS.
# On Windows use the PowerShell block at the bottom.

# Base URL: the scripts append /v1/chat/completions or /v1/embeddings if missing
export LLM_ENDPOINT="http://10.0.0.10:8000"

# Bearer token. Prefer this over -k: a flag is visible in `ps aux` and history.
export LLM_API_KEY="sk-change-me"

# Chat model, as the server names it (see: curl $LLM_ENDPOINT/v1/models)
export LLM_MODEL="Qwen/Qwen2.5-7B-Instruct"

# Embedding model, if it differs from LLM_MODEL
export LLM_EMBED_MODEL="BAAI/bge-m3"

# ---------------------------------------------------------------------------
# PowerShell equivalent:
#
#   $env:LLM_ENDPOINT    = 'http://10.0.0.10:8000'
#   $env:LLM_API_KEY     = 'sk-change-me'
#   $env:LLM_MODEL       = 'Qwen/Qwen2.5-7B-Instruct'
#   $env:LLM_EMBED_MODEL = 'BAAI/bge-m3'
